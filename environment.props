<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<AfterTargets>Build</AfterTargets>
		<Pdb2MdbPath Condition="!Exists('$(Pdb2MdbPath)')">$(ProjectDir)\Libraries\Debug\pdb2mdb.exe</Pdb2MdbPath>

		<!-- Needs to be your path to the base Valheim folder -->
		<VALHEIM_INSTALL Condition="!Exists('$(VALHEIM_INSTALL)')">C:\Games\Steam\Steamapps\common\Valheim</VALHEIM_INSTALL>
		<VALHEIM_SERVER Condition="!Exists('$(VALHEIM_SERVERR)')">C:\Games\Steam\Steamapps\common\Valheim dedicated server</VALHEIM_SERVER>

		<!-- This is the folder where your build gets copied to when using the post-build automations -->
		<GalePath>$(AppData)\com.kesomannen.gale\valheim\profiles</GalePath>
		<BepInExPath>$(GalePath)\Default\BepInEx</BepInExPath>
		<MOD_DEPLOYPATH>$(GalePath)\Default\BepInEx\plugins</MOD_DEPLOYPATH>
		<SERVER_DEPLOYPATH>$(VALHEIM_SERVER)\BepInEx\plugins</SERVER_DEPLOYPATH>

		<CopyToServer>false</CopyToServer>
		<CopyResources>false</CopyResources>
	</PropertyGroup>
</Project>